{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":rebaseStalePrs",
    ":prImmediately",
    ":prHourlyLimitNone",
    ":prConcurrentLimitNone"
  ],
  "hostRules": [
    {
      "hostType": "docker",
      "matchHost": "index.docker.io",
      "username": "tomythical",
      "password": "{{ secrets.DOCKER_HUB_TOKEN }}"
    }
  ],
  "packageRules": [
    {
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "automerge": true,
      "platformAutomerge": true,
      "automergeType": "pr"
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "addLabels": [
        "major-update"
      ],
      "matchPackageNames": [
        "*"
      ]
    }
  ],
  "kubernetes": {
    "managerFilePatterns": [
      "/apps/.*\\.yaml$/",
      "/infra/.*\\.yaml$/"
    ]
  },
  "flux": {
    "managerFilePatterns": [
      "/apps/.*\\.yaml$/",
      "/infra/.*\\.yaml$/"
    ]
  },
  "dockerfile": {
    "managerFilePatterns": [
      "/apps/.*/Dockerfile$/"
    ]
  }
}
